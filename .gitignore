# Default: keep data, reports and generated outputs local.
# Source code, documentation and explicitly listed reproducibility files are eligible for review.
*
!*/
!.gitignore
!*.R
!*.r
!*.Rmd
!*.rmd
!*.py
!*.sh
!README.md
!README.*.md
!LICENSE
!LICENSE.*
!CITATION.cff
!/renv.lock
!/.Rprofile
!/.renvignore
!/MURANUCI_results.Rproj
!/renv/settings.json

# Installed packages and local renv state are not distributed.
/renv/library/
/renv/sandbox/
/renv/staging/
/renv/local/
/renv/cache/
/renv/cellar/
/renv/lock/

# Local R sessions, editor state and operating-system files.
.RData
.Rhistory
.Renviron
.Rproj.user/
.DS_Store
~$*
.env
.env.*

# Historical analyses and original inputs.
**/archive/
**/OLD/
**/OLD_versions/
**/OLD_PLOTS_TAX/
ARGs/inputs/

# Internal presentations and exploratory work.
presentacion_contexto_ARG/
Propuesta_Ecosistema_Metaphlan/

# Reviewed supplementary contig data (not raw pipeline inputs).
!ARGs/supplementary/paper_tables/curation/curated_contigs.csv
!ARGs/supplementary/paper_tables/curation/blast_queries.csv
!ARGs/supplementary/paper_tables/curation/contig_interpretations.csv
